{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "layer": "overlay",

  "control-center-width": 380,
  "control-center-height": 860,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,

  "notification-window-width": 380,
  "notification-icon-size": 36,
  "notification-body-image-height": 140,
  "notification-body-image-width": 180,

  "timeout": 8,
  "timeout-low": 6,
  "timeout-critical": 0,

  "ignore-gtk-theme": true,
  "notification-inline-reply": true,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 250,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,

  "widgets": [
    "mpris",
    "buttons-grid",
    "volume",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟  Clear All "
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 10,
      "loop-carousel": true
    },
    "volume": {
      "label": "󰕾",
      "device": "default",
      "slider": true,
      "show-per-app": true,
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰋋",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q \"[MUTED]\" && echo true || echo false'"
        },
        {
          "label": "󰍬",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q \"[MUTED]\" && echo true || echo false'"
        },
        {
          "label": "󰤨",
          "type": "toggle",
          "command": "sh -c 'nmcli radio wifi | grep -q \"enabled\" && nmcli radio wifi off || nmcli radio wifi on'",
          "update-command": "sh -c 'nmcli radio wifi | grep -q \"enabled\" && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "rfkill toggle bluetooth",
          "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: no\" && echo true || echo false'"
        },
        {
          "label": "󰖔",
          "type": "toggle",
          "command": "sh -c 'which hyprsunset >/dev/null 2>&1 && (pgrep -x hyprsunset >/dev/null && pkill -x hyprsunset || hyprsunset --temperature 3500 &)'",
          "update-command": "sh -c 'pgrep -x hyprsunset >/dev/null && echo true || echo false'"
        }
      ]
    }
  }
}
