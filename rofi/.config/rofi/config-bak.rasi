configuration {
    display-drun: "Applications";
    display-window: "Windows";
    font: "JetBrainsMono Nerd Font Mono 12";
    drun-display-format: "{icon} {name}";
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus";
}

